#!/usr/bin/env sh
# Run the game. Extra arguments are passed through to the binary.
#
#   ./run                 debug build
#   BW_DEV=1 ./run        dynamic Bevy linking, much faster incremental builds
#   BW_RELEASE=1 ./run    optimised build
#
#   BW_VIEW=35 ./run      world metres visible vertically; default 28
#
#   BW_GRASS_TRACED=1 ./run   read path-traced pages where they have been baked
#
# The game rasterises. Cycles takes seconds a page and a frame is 16 ms, so the
# path tracer cannot run here — it runs ahead of time, and the game reads what it
# left. `grass_prebake` fills that cache.
#
# Traced pages are opt-in because a traced page and a rasterised one are two
# different pictures, and one of each side by side reads as a rendering fault
# rather than as an improvement. Trace a region that covers the view first.
#
# To look at the renderer at its best, use `./render` instead: it places and
# traces one whole scene with no page grid at all.
#
# The default frames about 50 x 28 metres of ground. The number that decides it
# is how tall a person is on screen rather than how much ground is visible: at
# 55 a 1.8 m figure is about 35 pixels on a 1080p window, which is where
# Warcraft III and Age of Empires sit. At 28 the same figure is 69 pixels and
# the view reads as an action game rather than a strategy one.
#
#   cargo run --release -p bw_grass --example grass_bake -- --view 28 --ruler
#
# renders exactly what the window will show at a given height, with unit-sized
# markers for scale. Judge the ground with that, never with a 1:1 plate.
set -e

cd "$(dirname "$0")"

if [ "${BW_RELEASE:-}" = "1" ]; then
	exec cargo run --release -- "$@"
elif [ "${BW_DEV:-}" = "1" ]; then
	exec cargo run --features dev -- "$@"
else
	exec cargo run -- "$@"
fi
