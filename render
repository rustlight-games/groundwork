#!/usr/bin/env sh
# Place a whole scene in Rust and path-trace it with Cycles, in one go.
#
#   ./render                    what the game shows, path-traced. Opened when done
#   TERRAIN_VIEW=10 ./render         closer: world metres visible vertically
#   TERRAIN_SAMPLES=512 ./render     cleaner, slower
#   TERRAIN_SIZE=2560x1440 ./render  bigger
#   TERRAIN_SUPERSAMPLE=2 ./render   override the derived supersample (0 = derive)
#   TERRAIN_TILES=4 ./render         override the derived tile split (0 = derive)
#   TERRAIN_SEED=12 ./render         somewhere else entirely
#
# This is not `./run`. The game streams pages and has a frame to draw them in;
# Cycles takes seconds, so it cannot run in a render loop. What it can do is
# render the whole thing at once, which is both simpler and better for looking
# at: no page grid, no seams to reason about, one camera over one scene.
#
# Placement is unchanged either way — every blade is a pure function of its world
# coordinate, so this is the same meadow the game grows, rendered properly.
#
# ## The framing matches `./run`
#
# `TERRAIN_VIEW` is world metres visible vertically, the same number `./run` takes,
# and it defaults to the same 28. So this is the picture the game is trying to
# be, rendered properly, rather than a flattering close-up of it.
#
# Everything a wide view needs is derived, and the reasoning is worth knowing
# because three plausible approaches failed before this one.
#
# A grass blade is about three millimetres across, so it covers one pixel at
# roughly 330 pixels to the metre. The RTS overview shows 39. Below one pixel a
# blade is not a thin blade, it is a *partially covered* pixel — and a canopy of
# those averages to a flat wash with no highlights and no tufts, however dense it
# is and however many samples it gets.
#
# So the trace detail is held fixed at 330 and the supersample is derived from
# the framing. A wide view is not a coarser render; it is the same render over
# more ground, filtered down further. Which costs geometry — fifty-five million
# blades at the game framing — so the scene is split into tiles, each grown with
# a guard band and cropped. Tiles are seamless for free, because placement is a
# pure function of world position.
#
# The count of both is arithmetic rather than a guess: guessing wrong is Blender
# taking a segmentation fault several minutes in, not a slow render.
#
# `TERRAIN_VIEW=10 ./render` for the close-up the look was tuned at.
set -e

cd "$(dirname "$0")"

SIZE="${TERRAIN_SIZE:-1920x1080}"
WIDTH="${SIZE%x*}"
HEIGHT="${SIZE#*x}"
SAMPLES="${TERRAIN_SAMPLES:-256}"
VIEW="${TERRAIN_VIEW:-28}"
SUPERSAMPLE="${TERRAIN_SUPERSAMPLE:-0}"
SEED="${TERRAIN_SEED:-7}"
OUT="${TERRAIN_OUT:-target/grass-render.png}"

TILES="${TERRAIN_TILES:-0}"

echo "placing and tracing ${WIDTH}x${HEIGHT} at ${VIEW} m view, ${SAMPLES} spp, seed ${SEED}"

cargo run --release -p bw_grass --example grass_cycles -- \
	--width "$WIDTH" \
	--height "$HEIGHT" \
	--view "$VIEW" \
	--supersample "$SUPERSAMPLE" \
	--tiles "$TILES" \
	--samples "$SAMPLES" \
	--seed "$SEED" \
	--out "$OUT" \
	"$@"

echo
cargo run --release -p bw_grass --example grass_critique -- \
	"$OUT" --crop 1024 --target docs/art/grass-target.png || true

if [ "$(uname)" = "Darwin" ]; then
	open "$OUT"
fi
