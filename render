#!/usr/bin/env sh
# Nine isometric tiles, somewhere new, path-traced.
#
#   ./render                           a fresh world, traced. Opened when done
#   TERRAIN_SEED=5a17e33b ./render     that world again, exactly
#   TERRAIN_TILE=563,124 ./render      that tile as the subject
#   TERRAIN_TILE_M=4 ./render          bigger tiles, less detail per metre
#   TERRAIN_SAMPLES=512 ./render       cleaner, slower
#   TERRAIN_SIZE=3840x2160 ./render    bigger
#   TERRAIN_TRACE_TILES=4 ./render     override Blender's memory split
#
# The slow half of the pair. `./run` draws the same nine tiles through the cheap
# rasteriser in seconds; this integrates a hemisphere and takes minutes. Both
# frame through the same resolver, so a seed rendered by each gives two
# photographs of one meadow rather than two meadows that resemble each other.
#
# ## What a render is
#
# Nine square world tiles, three by three, with the middle one as the subject and
# the eight around it as set dressing. One continuous scene over all of them plus
# a halo — never nine scenes composited — so grass crosses the internal joins,
# shadows fall across them, and the colour field does not stop at a tile edge.
#
# The ground ends exactly at the layout's outer boundary and the film is
# transparent, so what comes out is an isometric diamond rather than a rectangle
# of grass. Blades rooted inside may lean past that edge; blades rooted outside
# shadow inward and are hidden from the camera.
#
# ## Why the trace resolution is what it is
#
# A grass blade is about three millimetres across, so it covers one pixel at
# roughly 330 pixels to the metre. Below that it is a *partially covered* pixel,
# and a canopy of those averages to a flat wash with no highlights and no tufts,
# however dense it is and however many samples it gets.
#
# So the trace detail is held fixed and the supersample is derived from the
# framing — a wide view is the same render over more ground, filtered down
# further, not a coarser one. That costs geometry, so the plate is traced in
# slices, each grown with a guard band and cropped. The slices are seamless for
# free, because placement is a pure function of world position. They are
# **not** the world tiles; see `--trace-tiles-across`.
#
# ## What comes out
#
#   target/terrain-render.png                the picture, RGBA
#   target/terrain-render-tiles.png          the nine tiles outlined and labelled
#   target/terrain-render-subject-mask.png   white inside the centre tile
#   target/terrain-render.ron                the seed, the tile, the framing
#
# Random, and reproducible: the last line printed is the command that produces
# this exact picture again.
set -e

cd "$(dirname "$0")"

SIZE="${TERRAIN_SIZE:-1920x1080}"
WIDTH="${SIZE%x*}"
HEIGHT="${SIZE#*x}"
SAMPLES="${TERRAIN_SAMPLES:-256}"
SUPERSAMPLE="${TERRAIN_SUPERSAMPLE:-0}"
TRACE_TILES="${TERRAIN_TRACE_TILES:-0}"
OUT="${TERRAIN_OUT:-target/terrain-render.png}"

set -- --width "$WIDTH" --height "$HEIGHT" \
	--samples "$SAMPLES" \
	--supersample "$SUPERSAMPLE" \
	--trace-tiles-across "$TRACE_TILES" \
	--out "$OUT"
[ -n "$TERRAIN_SEED" ] && set -- "$@" --seed "$TERRAIN_SEED"
[ -n "$TERRAIN_TILE" ] && set -- "$@" --centre-tile="$TERRAIN_TILE"
[ -n "$TERRAIN_TILE_M" ] && set -- "$@" --tile-size-m "$TERRAIN_TILE_M"
[ -n "$TERRAIN_FILL" ] && set -- "$@" --layout-fill "$TERRAIN_FILL"

cargo run --release -q -p terrain_cli -- render "$@"

if [ "$(uname)" = "Darwin" ]; then
	open "$OUT"
fi
