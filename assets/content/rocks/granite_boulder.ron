// Rocks are generated, not drawn: too many are needed, in too many sizes, for
// hand-authored art to keep up. See plugins/bw_fx_rocks.
(
    key: "granite_boulder",
    generator: "boulder",
    params: {
        "radius": Num(1.8),
        "sides": Int(16),
        "jaggedness": Num(0.22),
        "squareness": Num(2.6),
    },
    blocks_movement: true,
    scatter: Some((
        density_per_100_cells: 1.5,
        min_spacing: 4.0,
        allowed_terrain: ["grassland", "rocky"],
        elevation_range: (0, 255),
    )),
)
