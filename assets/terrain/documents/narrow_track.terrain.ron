// A narrow footpath, meadow on both sides.
//
// The transition test that `meadow_path` cannot do. That document puts one
// boundary across the plate with grass on one side and earth on the other, which
// proves the blend works and says nothing about what happens when two boundaries
// come close together.
//
// Here the whole track is under a metre wide, so the two edges are near enough
// to interfere:
//
//   - the **suppression bands overlap**. Vegetation is thinned from both sides
//     at once in the middle, and because the channel composes by `Multiply` the
//     two suppressions compound rather than fighting. A channel that composed by
//     `Min` or `Replace` would let the second band undo the first and the middle
//     of the track would grow grass.
//   - the **realised boundary has nowhere to wander**. The transition solver
//     moves a contour by roughly amplitude over gradient, so a tight band gets a
//     crisp edge from the same raggedness setting that gives a wide band big
//     interpenetrating islands. This is the crisp case; `meadow_path` is the
//     other one. Same numbers, and the difference is authored entirely in the
//     band widths below.
//   - **the earth never reaches its loose state**. Compaction covers the whole
//     width of a path this narrow, so the clod relief stays low and the track
//     reads as packed rather than churned — which is what a footpath is.
//
// If the middle of this track grows grass, or if its density is visibly higher
// than the meadow beside it, the shared candidate field is not being shared.
(
    format: "terrain-document",
    format_version: 2,
    document: (
        coordinate_system: "PlanarMetres",
        root_seed: "3c81f0d92ba64e57",

        metadata: (
            name: "Narrow track",
            description: "A footpath under a metre wide, with meadow on both sides.",
        ),

        materials: [
            (
                key: "meadow_soil",
                display_name: "Meadow Soil",
                appearance: "surface.ground",
                profile: Some("materials/meadow_floor.ground.ron"),
                vegetation_affinity: Some(1.0),
            ),
            (
                key: "dirt_compacted",
                display_name: "Compacted Dirt",
                appearance: "surface.ground",
                profile: Some("materials/compacted_loam.ground.ron"),
                vegetation_affinity: Some(0.0),
            ),
        ],

        modifier_channels: [
            (
                key: "dead_layer",
                display_name: "Dead bottom layer",
                range: (0.0, 1.0),
                // The middle of the range. A verge beside a footpath is neither
                // a hay meadow nor a summer-burnt pasture; it is ordinary grass
                // with an ordinary amount of last year's under it.
                default_value: 0.30,
                composition: "Max",
                unit: "Unitless",
                role: Some("DeadLitter"),
            ),
            (
                key: "vegetation_density",
                display_name: "Vegetation density",
                range: (0.0, 1.5),
                default_value: 1.0,
                // Multiply, and on a track this narrow that choice is
                // load-bearing rather than a preference — see the note above.
                composition: "Multiply",
                unit: "Unitless",
                role: Some("VegetationDensity"),
            ),
            (
                key: "tuft_density",
                display_name: "Grass tuft density",
                range: (0.0, 1.5),
                default_value: 1.0,
                composition: "Multiply",
                unit: "Unitless",
            ),
            (
                key: "fine_density",
                display_name: "Fine grass density",
                range: (0.0, 1.5),
                default_value: 1.0,
                composition: "Multiply",
                unit: "Unitless",
            ),
            (
                key: "thatch_density",
                display_name: "Thatch density",
                range: (0.0, 1.5),
                default_value: 0.4,
                composition: "Max",
                unit: "Unitless",
            ),
            (
                key: "flower_abundance",
                display_name: "Flower abundance",
                range: (0.0, 1.0),
                default_value: 0.3,
                composition: "Max",
                unit: "Unitless",
            ),
            (
                key: "stone_abundance",
                display_name: "Stone abundance",
                range: (0.0, 1.0),
                default_value: 0.12,
                composition: "Max",
                unit: "Unitless",
            ),
            (
                key: "grit_abundance",
                display_name: "Loose material",
                range: (0.0, 1.0),
                default_value: 0.0,
                composition: "Max",
                unit: "Unitless",
                role: Some("LooseMaterial"),
            ),
            (
                key: "soil_compaction",
                display_name: "Soil compaction",
                range: (0.0, 1.0),
                default_value: 0.1,
                composition: "Max",
                unit: "Unitless",
                role: Some("SoilCompaction"),
            ),
            (
                key: "soil_moisture",
                display_name: "Soil moisture",
                range: (0.0, 1.0),
                default_value: 0.45,
                composition: "Max",
                unit: "Unitless",
                role: Some("SoilMoisture"),
            ),
            (
                key: "undergrowth_abundance",
                display_name: "Undergrowth abundance",
                range: (0.0, 3.0),
                default_value: 1.0,
                // Multiply, so a path suppression and a shade suppression
                // compound rather than one of them winning.
                composition: "Multiply",
                unit: "Unitless",
                role: None,
            ),
        ],

        sources: [
            (
                key: "everywhere",
                source: Constant((value: 1.0)),
            ),
            (
                key: "track",
                source: SplineDistance((
                    asset: "features/narrow_track.spline.ron",
                    // Much tighter than the wide path's six metres. The bound
                    // sizes the spatial index as well as the value, and nothing
                    // here reads the spline past a metre and a half.
                    max_distance_m: 2.5,
                )),
            ),
            (
                key: "meadow_richness",
                source: Noise((
                    kind: "Perlin",
                    frequency_per_m: 0.35,
                    octaves: 3,
                    lacunarity: 2.0,
                    gain: 0.5,
                    stream: "meadow",
                )),
            ),
            (
                key: "damp_hollows",
                source: Noise((
                    kind: "Perlin",
                    frequency_per_m: 0.6,
                    octaves: 2,
                    lacunarity: 2.0,
                    gain: 0.5,
                    stream: "damp",
                )),
            ),
        ],

        layers: [
            (
                key: "base_meadow",
                mask: Source("everywhere"),
                operation: Material((
                    material: "meadow_soil",
                    mode: "Replace",
                    amount: 1.0,
                )),
            ),
            (
                key: "track_material",
                // 36 cm of bare core, and the ground is meadow again 62 cm from
                // the centreline. Under a metre wide all told.
                mask: Profile((
                    source: "track",
                    shape: SmoothBand((inner_m: 0.18, outer_m: 0.62)),
                )),
                operation: Material((
                    material: "dirt_compacted",
                    mode: "Replace",
                    amount: 1.0,
                )),
            ),
            (
                key: "track_depression",
                mask: Profile((
                    source: "track",
                    shape: SmoothBand((inner_m: 0.16, outer_m: 0.58)),
                )),
                // Shallower than the wide path's six centimetres. A footpath is
                // worn, not rutted.
                operation: Microrelief((mode: "Add", metres: -0.035)),
            ),
            (
                key: "track_compaction",
                mask: Profile((
                    source: "track",
                    shape: SmoothBand((inner_m: 0.20, outer_m: 0.60)),
                )),
                operation: Modifier((
                    channel: "soil_compaction",
                    mode: "Max",
                    value: 0.92,
                )),
            ),
            (
                key: "track_vegetation_suppression",
                mask: Profile((
                    source: "track",
                    // Wider than the material band by 26 cm, the same
                    // relationship the wide path uses. Grass thins before the
                    // ground stops being grass at every scale.
                    shape: SmoothBand((inner_m: 0.20, outer_m: 0.88)),
                )),
                operation: Modifier((
                    channel: "vegetation_density",
                    mode: "Multiply",
                    value: 0.05,
                )),
            ),
            (
                key: "track_fringe_thatch",
                mask: Profile((
                    source: "track",
                    shape: SmoothBand((inner_m: 0.62, outer_m: 1.10)),
                )),
                operation: Modifier((
                    channel: "thatch_density",
                    mode: "Max",
                    value: 1.1,
                )),
            ),
            (
                key: "track_grit",
                mask: Profile((
                    source: "track",
                    shape: SmoothBand((inner_m: 0.15, outer_m: 0.70)),
                )),
                operation: Modifier((
                    channel: "grit_abundance",
                    mode: "Max",
                    value: 1.0,
                )),
            ),
            (
                key: "rich_meadow",
                mask: Profile((
                    source: "meadow_richness",
                    shape: Ramp((low: 0.05, high: 0.65)),
                )),
                operation: Modifier((
                    channel: "flower_abundance",
                    mode: "Max",
                    value: 0.9,
                )),
            ),
            (
                key: "damp_ground",
                mask: Profile((
                    source: "damp_hollows",
                    shape: Ramp((low: 0.1, high: 0.7)),
                )),
                operation: Modifier((
                    channel: "soil_moisture",
                    mode: "Max",
                    value: 0.9,
                )),
            ),
        ],

        populations: [
            (
                key: "loose_grit",
                recipe: "population.dirt_clods",
                seed_stream: "grit",
                material_affinity: [("dirt_compacted", 1.0), ("meadow_soil", 1.0)],
                abundance_channel: Some("grit_abundance"),
                parameters: [
                    // A *supply*, not a rate. One candidate lattice has to
                    // serve every soil on the plate, so it must be at least the
                    // largest rate any profile here asks for — the bar's 220 a
                    // square metre — or that soil is silently capped at the
                    // supply and never reaches what it declared. Validation
                    // says so rather than leaving it to arithmetic.
                    //
                    // The radius is a reach bound for the same reason: it has to
                    // cover the largest `fragment_radius_m` in play, which is
                    // the loam's twenty millimetres.
                    ("density", Number(2700.0)),
                    ("radius_m", Number(0.010)),
                ],
            ),
            (
                // Densities are against the *tuned style's* own figures, not
                // against the generic family's defaults.
                //
                // A tuned population controls an existing pass rather than
                // scattering anything, so its density is a ratio: asking for
                // exactly what the style already does gives a factor of one and
                // the picture does not move. The tuned references are 50 tuft
                // anchors, 3800 fine blades and 395 thatch strokes a square
                // metre; the generic family's were 220, 1400 and 300, and
                // reading one as the other would have quadrupled every meadow.
                key: "meadow_tufts",
                recipe: "population.grass_tuft",
                seed_stream: "grass",
                material_affinity: [
                    ("meadow_soil", 1.0),
                    ("dirt_compacted", 0.15),
                ],
                abundance_channel: Some("tuft_density"),
                parameters: [
                    ("density", Number(54.5)),
                    ("length_m", Number(0.19)),
                    ("width_m", Number(0.0035)),
                    ("blades", Number(7.0)),
                ],
            ),
            (
                key: "meadow_fine_grass",
                recipe: "population.grass_fine",
                seed_stream: "fine",
                material_affinity: [
                    ("meadow_soil", 1.0),
                    ("dirt_compacted", 0.08),
                ],
                abundance_channel: Some("fine_density"),
                parameters: [
                    ("density", Number(2985.7)),
                    ("length_m", Number(0.085)),
                ],
            ),
            (
                key: "meadow_thatch",
                recipe: "population.ground_thatch",
                seed_stream: "thatch",
                material_affinity: [
                    ("meadow_soil", 1.0),
                    ("dirt_compacted", 0.5),
                ],
                abundance_channel: Some("thatch_density"),
                parameters: [
                    ("density", Number(421.3)),
                    ("length_m", Number(0.065)),
                ],
            ),
            (
                key: "meadow_flowers",
                recipe: "population.meadow_flowers",
                seed_stream: "flowers",
                material_affinity: [("meadow_soil", 1.0)],
                abundance_channel: Some("flower_abundance"),
                parameters: [
                    ("density", Number(8.0)),
                    ("stem_length_m", Number(0.26)),
                    ("head_radius_m", Number(0.014)),
                ],
            ),
            (
                key: "field_stones",
                recipe: "population.field_stones",
                seed_stream: "stones",
                material_affinity: [],
                abundance_channel: Some("stone_abundance"),
                parameters: [
                    ("density", Number(0.8)),
                    ("radius_m", Number(0.05)),
                ],
            ),
            (
                key: "meadow_undergrowth",
                recipe: "population.meadow_undergrowth",
                seed_stream: "undergrowth",
                material_affinity: [("meadow_soil", 1.0)],
                abundance_channel: Some("undergrowth_abundance"),
                parameters: [
                    ("density", Number(5.0)),
                    ("leaf_length_m", Number(0.12)),
                    ("leaf_width_m", Number(0.035)),
                    ("crown_radius_m", Number(0.02)),
                ],
            ),
        ],
    ),
)
