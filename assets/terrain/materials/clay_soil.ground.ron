// Plastic clay: smooth when wet, cracked when dry.
//
// Clay is the material that most rewards separating structure from state. It
// barely clods — its coarse band is a swell rather than a lump — and almost
// everything interesting about it is what moisture does: at the wet end it goes
// glossy and holds every mark pressed into it, and at the dry end it opens the
// polygon network below.
(
    format: "ground-material",
    format_version: 1,
    material: (
        key: "clay_soil",
        display_name: "Clay soil",

        optics: (
            dry_palette: (
                low:  (0.0330, 0.0205, 0.0125),
                mid:  (0.0700, 0.0430, 0.0250),
                high: (0.1300, 0.0800, 0.0470),
            ),
            // The lowest wet roughness of any soil here. Clay's particles are
            // small enough that a film covers them completely rather than
            // draping over a rough aggregate.
            wet: (
                wet_mid: (0.0245, 0.0125, 0.0058),
                roughness_wet: 0.12,
                saturation_flattening: 0.65,
            ),
            roughness_dry: (0.74, 0.90),
            ior: 1.55,

            region_wavelength_m: 2.0,
            region_strength: 0.7,
            patch_wavelength_m: 0.35,
            patch_strength: 0.55,
            grain_strength: 0.40,
        ),

        structure: (
            bands: [
                (wavelength_m: 0.0700, amplitude_m: 0.0120, compaction_response: 0.70, clustered: true),
                (wavelength_m: 0.0100, amplitude_m: 0.0025, compaction_response: 0.55, clustered: true),
                (wavelength_m: 0.0015, amplitude_m: 0.0005, compaction_response: 0.25),
            ],
            cluster_wavelength_m: 1.0,
            cluster_strength: 0.40,
            cohesion: 0.92,
        ),

        cracks: Some((
            polygon_m: 0.16,
            width_m: 0.010,
            depth_m: 0.030,
            secondary: 0.45,
            curl_m: 0.004,
            moisture_ceiling: 0.45,
        )),

        scatter: (
            grit_per_m2: 30.0,
            pebble_per_m2: 0.15,
            fragment_radius_m: (0.003, 0.012),
        ),

        vegetation_affinity: 0.15,
    ),
)
