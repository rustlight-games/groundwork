// The ground under a canopy.
//
// Almost none of this is ever seen directly, and it is doing more work than its
// visible area suggests: it separates one tuft from the next, makes a density
// change legible, and gives the eye somewhere to rest. A canopy with nothing at
// all between it reads as fur rather than as plants standing in ground.
//
// ## Why it is this dark
//
// These values were three times brighter for one render and the result was not
// "pale soil", it was a **rock** — a broad patch bright enough to hold its own
// against the canopy stops reading as ground seen between plants and starts
// reading as an object lying on top of them. Nothing about the shader said
// boulder; the value did.
//
// So the floor stays well under the grass it sits between. Compare
// `compacted_loam.ground.ron`, which is the same physical soil seen on an open
// track and is four times brighter, because there it is the subject rather than
// the gap.
//
// Note the low stop is the only colour here with more green than red. Ground
// glimpsed in the deepest shade of a canopy is lit almost entirely by light that
// has already passed through a leaf.
(
    format: "ground-material",
    format_version: 1,
    material: (
        key: "meadow_floor",
        display_name: "Meadow floor",

        optics: (
            dry_palette: (
                // Grey-green, and that is the composition signal that keeps
                // this a different soil from the track rather than the same one
                // in shade. Root-bound organic ground is bound by *plants*: it
                // is full of humus and fine root, which is grey, and the track
                // beside it is scoured mineral, which is red. Occlusion scales
                // every channel by one number and cannot produce a ratio
                // difference, so a ratio difference is composition and nothing
                // else — see `soil_decision.rs`, which fails if the gap closes.
                low:  (0.0092, 0.0086, 0.0072),
                mid:  (0.0215, 0.0194, 0.0134),
                high: (0.0930, 0.0846, 0.0600),
            ),
            // A shaded floor is half damp already, so soaking it moves it less
            // than it moves an open track — and it never goes glossy, because a
            // sheen down there would be a specular highlight arriving from a
            // direction the canopy has already blocked.
            wet: (
                // ## Wet is a *state*, and it has to be obviously one
                //
                // Three numbers carry the whole difference between this soil
                // dry and the same soil soaked, and each was too timid to be
                // seen. Measured on the plate, saturated ground came back with
                // a dynamic range of 2.26x against dry ground's 2.31x — which
                // is to say the wet response was doing nothing a viewer could
                // point at.
                //
                //   `wet_mid`               where the colour lands
                //   `roughness_wet`         whether it goes glossy
                //   `saturation_flattening` whether it slumps
                //
                // The colour goes *neutral* rather than richer. A water film
                // absorbs across the spectrum and kills the internal scattering
                // that makes dry earth chromatic, so wet soil moves toward
                // black-brown — and letting the warm sun and the cool sky
                // supply the colour from there is what makes it read as a
                // surface rather than as a darker paint.
                wet_mid: (0.0074, 0.0070, 0.0062),
                // Glossy. Thirty was a hedge against the canopy — this soil
                // lives under grass and was authored never to go shiny — which
                // is lighting context baked into a physical response, and it
                // stops being true the moment a document exposes the soil. A
                // bare saturated hollow is the glossiest ground there is.
                roughness_wet: 0.26,
                // Twice what it was. Saturated cohesive soil slumps: the crumb
                // loses its edges and the surface reads as poured rather than
                // crumbled. A third was not visible against the mound field's
                // own relief.
                saturation_flattening: 0.70,
            ),
            roughness_dry: (0.78, 0.98),
            ior: 1.50,

            // Damp and dry regions at two metres, scuffs at a quarter of one.
            // The region band is the stronger of the two: earth does not change
            // moisture over four centimetres, and driving the blend from the
            // finer band puts a visible boundary wherever damp meets dry.
            region_wavelength_m: 2.0,
            region_strength: 0.9,
            patch_wavelength_m: 0.25,
            patch_strength: 0.5,
            grain_strength: 0.55,
        ),

        // No band here is coarse enough to reach the mesh, and that is correct
        // rather than a limitation: the relief a meadow floor has at clod scale
        // is hidden under the canopy, and paying for it in vertices would buy
        // nothing. What the mesh does carry under a meadow is the mound field.
        structure: (
            bands: [
                (wavelength_m: 0.0385, amplitude_m: 0.0110, compaction_response: 0.35, clustered: true),
                (wavelength_m: 0.0111, amplitude_m: 0.0035, compaction_response: 0.25),
            ],
            cluster_wavelength_m: 1.2,
            cluster_strength: 0.35,
            cohesion: 0.45,
        ),

        scatter: (
            grit_per_m2: 40.0,
            pebble_per_m2: 0.2,
            fragment_radius_m: (0.003, 0.015),
        ),

        vegetation_affinity: 1.0,
    ),
)
