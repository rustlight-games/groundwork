// Fine granular sand, rippled by wind and flattened by water.
//
// ## The ripples are the material
//
// Isotropic noise at ripple amplitude reads as a rough plane. What makes sand
// look like sand is that its relief is *coherent over distance* — one crest
// implies the next, in a direction — and that is the one thing a noise texture
// cannot supply on its own. Hence a declared direction, wavelength and meander
// rather than another octave.
//
// `wetness_suppression` at 0.85 is the second half of it. Wet sand does not
// ripple: the water holds the grains where they are, so the wet line is visible
// as a change in *texture* as much as in colour, which is exactly what a
// photograph of a beach shows.
(
    format: "ground-material",
    format_version: 1,
    material: (
        key: "beach_sand",
        display_name: "Beach sand",

        optics: (
            // Far less saturated than any soil here — G/R 0.84, B/R 0.64. Sand
            // is a mineral with the organic matter washed out of it, and getting
            // that ratio wrong is what makes pale soil read as sand and sand
            // read as pale soil.
            dry_palette: (
                low:  (0.1300, 0.1080, 0.0810),
                mid:  (0.2200, 0.1850, 0.1400),
                high: (0.3400, 0.2900, 0.2250),
            ),
            // Sand darkens more dramatically than soil, because there is more
            // brightness to lose and its grains are transparent enough that a
            // film between them changes the scattering completely.
            wet: (
                wet_mid: (0.0700, 0.0560, 0.0400),
                roughness_wet: 0.10,
                saturation_flattening: 0.80,
            ),
            roughness_dry: (0.88, 0.98),
            ior: 1.46,

            // Weak colour variation, strong geometric variation. Sand's tonal
            // range comes from its relief catching light, not from mottling.
            region_wavelength_m: 3.0,
            region_strength: 0.6,
            patch_wavelength_m: 0.40,
            patch_strength: 0.40,
            grain_strength: 0.35,
        ),

        structure: (
            bands: [
                (wavelength_m: 0.0300, amplitude_m: 0.0050, compaction_response: 0.50, clustered: true),
                (wavelength_m: 0.0045, amplitude_m: 0.0012, compaction_response: 0.32),
                // Sub-millimetre and angular: this is the band that glints.
                (wavelength_m: 0.0008, amplitude_m: 0.0003, shape: "Angular", compaction_response: 0.12),
            ],
            cluster_wavelength_m: 2.0,
            cluster_strength: 0.30,
            cohesion: 0.10,
        ),

        ripples: Some((
            wavelength_m: 0.14,
            amplitude_m: 0.006,
            direction_deg: 22.0,
            crest_sharpness: 0.35,
            asymmetry: 0.15,
            meander_m: 0.9,
            wetness_suppression: 0.85,
        )),

        scatter: (
            grit_per_m2: 260.0,
            pebble_per_m2: 1.2,
            fragment_radius_m: (0.002, 0.018),
        ),

        // Dune grass, and only just.
        vegetation_affinity: 0.08,
    ),
)
