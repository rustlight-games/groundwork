// Freshly turned field: big clustered clods, dark crevices, a lot of grit.
//
// The clustering is the whole character. A field uniformly covered in clods
// reads as gravel; real turned soil has smooth stretches where the blade ran
// clean beside broken ones where it did not, and `cluster_strength` at 0.75 is
// what puts that alternation in.
(
    format: "ground-material",
    format_version: 1,
    material: (
        key: "loose_farm_soil",
        display_name: "Loose farm soil",

        optics: (
            // Richer and slightly cooler than a worn track — more organic
            // matter, and none of it packed down. G/R 0.66, B/R 0.40.
            dry_palette: (
                low:  (0.0070, 0.0062, 0.0058),
                mid:  (0.0480, 0.0316, 0.0192),
                high: (0.2050, 0.1330, 0.0790),
            ),
            wet: (
                wet_mid: (0.0180, 0.0098, 0.0048),
                roughness_wet: 0.24,
                saturation_flattening: 0.50,
            ),
            roughness_dry: (0.86, 0.99),
            ior: 1.50,

            region_wavelength_m: 2.5,
            region_strength: 0.6,
            patch_wavelength_m: 0.30,
            patch_strength: 0.85,
            grain_strength: 0.60,
        ),

        structure: (
            bands: [
                (wavelength_m: 0.0900, amplitude_m: 0.0380, shape: "RoundedRidged", compaction_response: 0.45, clustered: true),
                (wavelength_m: 0.0220, amplitude_m: 0.0090, shape: "Angular", compaction_response: 0.35, clustered: true),
                (wavelength_m: 0.0035, amplitude_m: 0.0014, compaction_response: 0.18),
            ],
            cluster_wavelength_m: 0.55,
            cluster_strength: 0.75,
            cohesion: 0.55,
        ),

        scatter: (
            grit_per_m2: 180.0,
            pebble_per_m2: 2.2,
            fragment_radius_m: (0.006, 0.035),
        ),

        // Enough to green over at the edges of a field, nowhere near a meadow.
        vegetation_affinity: 0.25,
    ),
)
