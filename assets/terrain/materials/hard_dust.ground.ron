// Hardpan: compacted silt under a film of powder.
//
// Characterised by restraint. Low relief at every scale, very high roughness,
// sparse angular fragments, and cracks where the clay in it has dried. A hardpan
// rendered with the amplitudes a farm soil wants stops being hardpan.
(
    format: "ground-material",
    format_version: 1,
    material: (
        key: "hard_dust",
        display_name: "Hard dust",

        optics: (
            // Pale and desaturated by the powder lying on it — G/R 0.82, B/R
            // 0.63 — which is nearly sand's ratio at half sand's brightness.
            dry_palette: (
                low:  (0.0700, 0.0570, 0.0420),
                mid:  (0.1250, 0.1030, 0.0790),
                high: (0.2000, 0.1680, 0.1330),
            ),
            wet: (
                wet_mid: (0.0440, 0.0330, 0.0230),
                roughness_wet: 0.22,
                saturation_flattening: 0.55,
            ),
            // The roughest ground here. Powder is a mass of unresolved edges.
            roughness_dry: (0.94, 1.00),
            ior: 1.50,

            region_wavelength_m: 2.5,
            region_strength: 0.55,
            patch_wavelength_m: 0.45,
            patch_strength: 0.50,
            grain_strength: 0.45,
        ),

        structure: (
            bands: [
                (wavelength_m: 0.0450, amplitude_m: 0.0060, shape: "Angular", compaction_response: 0.65, clustered: true),
                (wavelength_m: 0.0060, amplitude_m: 0.0015, shape: "Angular", compaction_response: 0.45, clustered: true),
                (wavelength_m: 0.0010, amplitude_m: 0.0003, compaction_response: 0.22),
            ],
            cluster_wavelength_m: 1.6,
            cluster_strength: 0.50,
            cohesion: 0.70,
        ),

        cracks: Some((
            polygon_m: 0.22,
            width_m: 0.006,
            depth_m: 0.018,
            secondary: 0.55,
            curl_m: 0.002,
            moisture_ceiling: 0.30,
        )),

        scatter: (
            grit_per_m2: 120.0,
            pebble_per_m2: 0.8,
            fragment_radius_m: (0.004, 0.030),
        ),

        vegetation_affinity: 0.05,
    ),
)
